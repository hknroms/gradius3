rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {

      // 本人のみ自分の申請状況を閲覧可能
      allow read: if request.auth != null
        && request.auth.uid == userId;

      // 新規申請は本人が pending として作成する場合だけ許可
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'email', 'status', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      // クライアントからの変更・削除は禁止。
      // 承認はFirebase管理画面から実施
      allow update, delete: if false;
    }

    // 管理者の一覧（共同作業のまとめページの扉が使う）。本人が自分の分だけ読める。
    // 書き込みは申請の管理画面（Apps Script・持ち主の権限）から。ページからは書けない。
    match /admins/{email} {
      allow read: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // まとめページ（docs/status.html）のボタン用 GitHub トークン。管理者として登録された本人だけが自分の分を読み書き・削除できる（2026-10-31）。
    match /admin_tokens/{userId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == userId
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.token is string && request.resource.data.token.size() <= 300
        && request.resource.data.updatedAt == request.time;
    }

    // ステレオの聞き比べの記録（docs/stereo/sim.html の「記録を管理者に送る」）。
    // 承認された本人だけが自分の分を書ける・読める。管理者は申請の管理画面（Apps Script）で全員分を見る。
    match /stereo_results/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'count', 'favs', 'data', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.count is int && request.resource.data.favs is int
        && request.resource.data.data is string && request.resource.data.data.size() <= 900000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // 「確かめてほしいこと」のボタン（docs/testplay.html の「直っていた／まだおかしい」）。承認された人が押すと1件作る。
    // ページからは読めない・変えられない。申請の管理画面（Apps Script・持ち主の権限）が5分ごとに読んで GitHub に載せ、消す。
    match /rechecks/{id} {
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'issue', 'result', 'version', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.issue is int && request.resource.data.issue > 0 && request.resource.data.issue < 100000
        && request.resource.data.result in ['直っていた', 'まだおかしい']
        && request.resource.data.version is string && request.resource.data.version.size() <= 20
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
